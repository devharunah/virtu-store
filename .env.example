# Copy to .env.local and fill in. Read through requireEnv() (src/lib/env.ts, see CLAUDE.md).
# Add every new variable here in the same commit as the code that reads it.

# Firebase web app config for seller shops (Auth + Firestore). Firebase console →
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
# These are public by design; firestore.rules is what protects the data.
# Without them the app still runs: /stores shows the demo shops and /sell says it isn't set up.
# See docs/FIREBASE-SETUP.md.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. "true" uses the local emulators (pnpm emulators) instead of a real project; pair it
# with project id demo-virtu and any placeholder values above. No Firebase account needed.
NEXT_PUBLIC_FIREBASE_EMULATORS=
